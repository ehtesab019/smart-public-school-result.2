<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Public School Aandhar Kotta - Admission Portal</title>
    <!-- Include html2pdf library for direct PDF generation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #f0f4f8;
            color: #333;
            line-height: 1.6;
            padding: 20px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background: #ffffff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 20px;
        }
        .school-logo {
            width: 80px;
            height: 80px;
            object-fit: contain;
            margin-bottom: 10px;
            border-radius: 50%;
            border: 2px solid #1e3a8a;
            padding: 2px;
            background: #fff;
        }
        .header h1 {
            color: #1e3a8a;
            font-size: 26px;
            margin-bottom: 5px;
        }
        .header p {
            color: #64748b;
            font-size: 14px;
        }
        .form-section {
            margin-bottom: 25px;
        }
        .form-section h3 {
            color: #1e3a8a;
            font-size: 18px;
            margin-bottom: 15px;
            border-left: 4px solid #3b82f6;
            padding-left: 10px;
        }
        .grid-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 15px;
        }
        .grid-full {
            margin-bottom: 15px;
        }
        label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
            color: #334155;
            font-size: 14px;
        }
        input, select, textarea {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 14px;
            transition: all 0.3s ease;
        }
        input:focus, select:focus, textarea:focus {
            border-color: #3b82f6;
            outline: none;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }
        .photo-upload-box {
            border: 2px dashed #cbd5e1;
            padding: 15px;
            text-align: center;
            border-radius: 6px;
            background: #f8fafc;
        }
        .btn-submit {
            background-color: #2563eb;
            color: white;
            padding: 14px 20px;
            border: none;
            border-radius: 6px;
            width: 100%;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s ease;
            margin-top: 10px;
        }
        .btn-submit:hover {
            background-color: #1d4ed8;
        }

        /* Printable / PDF Ticket Styling */
        #pdf-template {
            display: none;
            background: #fff;
            padding: 30px;
            width: 100%;
            max-width: 750px;
            margin: auto;
            color: #1e293b;
        }
        .pdf-header {
            text-align: center;
            border-bottom: 2px solid #1e3a8a;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .pdf-logo {
            width: 60px;
            height: 60px;
            object-fit: contain;
            margin-bottom: 5px;
        }
        .pdf-header h2 {
            color: #1e3a8a;
            font-size: 22px;
        }
        .pdf-meta {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            background: #f1f5f9;
            padding: 10px 15px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 14px;
        }
        .pdf-body-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }
        .pdf-table {
            width: 100%;
            border-collapse: collapse;
        }
        .pdf-table th, .pdf-table td {
            border: 1px solid #cbd5e1;
            padding: 10px 12px;
            font-size: 13px;
            text-align: left;
        }
        .pdf-table th {
            background-color: #f8fafc;
            color: #475569;
            width: 35%;
        }
        .pdf-photo-container {
            text-align: center;
            border: 1px solid #cbd5e1;
            padding: 10px;
            background: #fff;
            border-radius: 6px;
            height: max-content;
        }
        .pdf-photo-container img {
            width: 100px;
            height: 120px;
            object-fit: cover;
            border-radius: 4px;
        }
        .pdf-footer {
            text-align: center;
            margin-top: 30px;
            font-size: 12px;
            color: #64748b;
            border-top: 1px solid #e2e8f0;
            padding-top: 15px;
        }
    </style>
</head>
<body>

<div class="container" id="form-container">
    <div class="header">
        <!-- School Logo Placeholder / Upload option -->
        <input type="file" id="schoolLogoInput" accept="image/*" style="display:none;" onchange="previewLogo(event)">
        <img id="displayLogo" src="https://cdn-icons-png.flaticon.com/512/2942/2942813.png" alt="School Logo" class="school-logo" title="Click to change logo" onclick="document.getElementById('schoolLogoInput').click()" style="cursor: pointer;">
        <h1>Smart Public School Aandhar Kotta</h1>
        <p>Admission Application Form | Academic Session 2026-2027 (Nursery to Class 3)</p>
    </div>

    <form id="admissionForm" onsubmit="generatePDF(event)">
        <!-- Section 1: Class Selection -->
        <div class="form-section">
            <h3>Admission Details</h3>
            <div class="grid-row">
                <div>
                    <label for="applyClass">Applying For Class *</label>
                    <select id="applyClass" required>
                        <option value="">-- Select Class --</option>
                        <option value="Nursery">Nursery</option>
                        <option value="LKG">LKG</option>
                        <option value="UKG">UKG</option>
                        <option value="Class 1">Class 1</option>
                        <option value="Class 2">Class 2</option>
                        <option value="Class 3">Class 3</option>
                    </select>
                </div>
                <div>
                    <label for="academicYear">Academic Session</label>
                    <input type="text" id="academicYear" value="2026-2027" readonly style="background-color: #f1f5f9;">
                </div>
            </div>
        </div>

        <!-- Section 2: Student Personal Info -->
        <div class="form-section">
            <h3>Student's Personal Information</h3>
            <div class="grid-row">
                <div>
                    <label for="firstName">First Name *</label>
                    <input type="text" id="firstName" placeholder="Enter first name" required>
                </div>
                <div>
                    <label for="lastName">Last Name *</label>
                    <input type="text" id="lastName" placeholder="Enter last name" required>
                </div>
            </div>

            <div class="grid-row">
                <div>
                    <label for="dob">Date of Birth *</label>
                    <input type="date" id="dob" required>
                </div>
                <div>
                    <label for="gender">Gender *</label>
                    <select id="gender" required>
                        <option value="">-- Select Gender --</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            <div class="grid-row">
                <div>
                    <label for="bloodGroup">Blood Group</label>
                    <select id="bloodGroup">
                        <option value="">-- Select --</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                    </select>
                </div>
                <div>
                    <label for="studentPhoto">Upload Student Photograph *</label>
                    <div class="photo-upload-box">
                        <input type="file" id="studentPhoto" accept="image/*" required onchange="previewImage(event)">
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 3: Parent/Guardian Details -->
        <div class="form-section">
            <h3>Parent / Guardian Details</h3>
            <div class="grid-row">
                <div>
                    <label for="fatherName">Father's Full Name *</label>
                    <input type="text" id="fatherName" placeholder="Enter father's name" required>
                </div>
                <div>
                    <label for="fatherOccupation">Father's Occupation</label>
                    <input type="text" id="fatherOccupation" placeholder="Enter occupation">
                </div>
            </div>

            <div class="grid-row">
                <div>
                    <label for="motherName">Mother's Full Name *</label>
                    <input type="text" id="motherName" placeholder="Enter mother's name" required>
                </div>
                <div>
                    <label for="motherOccupation">Mother's Occupation</label>
                    <input type="text" id="motherOccupation" placeholder="Enter occupation">
                </div>
            </div>

            <div class="grid-row">
                <div>
                    <label for="contactNumber">Primary Contact Number *</label>
                    <input type="tel" id="contactNumber" placeholder="10-digit mobile number" pattern="[0-9]{10}" required>
                </div>
                <div>
                    <label for="email">Email Address</label>
                    <input type="email" id="email" placeholder="example@email.com">
                </div>
            </div>
        </div>

        <!-- Section 4: Address Details -->
        <div class="form-section">
            <h3>Residential Address</h3>
            <div class="grid-full">
                <label for="address">Street Address *</label>
                <textarea id="address" rows="2" placeholder="House No, Street Name, Locality/Area" required></textarea>
            </div>
            <div class="grid-row">
                <div>
                    <label for="city">City / District *</label>
                    <input type="text" id="city" placeholder="Enter city" required>
                </div>
                <div>
                    <label for="pincode">Pincode *</label>
                    <input type="text" id="pincode" placeholder="6-digit pincode" pattern="[0-9]{6}" required>
                </div>
            </div>
        </div>

        <button type="submit" class="btn-submit">Submit Application & Download PDF Receipt</button>
    </form>
</div>

<!-- Hidden PDF Output Template -->
<div id="pdf-template">
    <div class="pdf-header">
        <img id="pdfLogoPreview" src="https://cdn-icons-png.flaticon.com/512/2942/2942813.png" alt="School Logo" class="pdf-logo">
        <h2>SMART PUBLIC SCHOOL AANDHAR KOTTA</h2>
        <p>Official Admission Application Receipt (Session 2026-27)</p>
    </div>

    <div class="pdf-meta">
        <div>Registration No: <span id="lblRegNo"></span></div>
        <div>Form No: <span id="lblFormNo"></span></div>
        <div>Date: <span id="lblDate"></span></div>
    </div>

    <div class="pdf-body-grid">
        <table class="pdf-table">
            <tr>
                <th>Applied Class</th>
                <td id="lblClass"></td>
            </tr>
            <tr>
                <th>Student's Name</th>
                <td id="lblStudentName"></td>
            </tr>
            <tr>
                <th>Date of Birth</th>
                <td id="lblDob"></td>
            </tr>
            <tr>
                <th>Gender</th>
                <td id="lblGender"></td>
            </tr>
            <tr>
                <th>Father's Name</th>
                <td id="lblFatherName"></td>
            </tr>
            <tr>
                <th>Mother's Name</th>
                <td id="lblMotherName"></td>
            </tr>
            <tr>
                <th>Contact Number</th>
                <td id="lblContact"></td>
            </tr>
            <tr>
                <th>Residential Address</th>
                <td id="lblAddressText"></td>
            </tr>
        </table>
        
        <div class="pdf-photo-container">
            <img id="lblPhotoPreview" src="" alt="Student Photo">
            <p style="font-size: 11px; margin-top: 5px; color: #64748b;">Candidate Photo</p>
        </div>
    </div>

    <div class="pdf-footer">
        <p>This is a computer-generated admission receipt. Please keep this document safe for future admission reference.</p>
        <p>Smart Public School Aandhar Kotta | Contact: +91-XXXXXXXXXX | Email: admissions@smartpublicschool.edu</p>
    </div>
</div>

<script>
    let uploadedImageBase64 = "";
    let schoolLogoBase64 = "https://cdn-icons-png.flaticon.com/512/2942/2942813.png";

    function previewLogo(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                schoolLogoBase64 = e.target.result;
                document.getElementById('displayLogo').src = schoolLogoBase64;
                document.getElementById('pdfLogoPreview').src = schoolLogoBase64;
            }
            reader.readAsDataURL(file);
        }
    }

    function previewImage(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                uploadedImageBase64 = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    }

    function generatePDF(event) {
        event.preventDefault();

        // Auto generate Form Number and Registration Number
        const randomNum = Math.floor(100000 + Math.random() * 900000);
        const regNo = "SPS-AK-2026-" + randomNum;
        const formNo = "FM-" + Math.floor(1000 + Math.random() * 9000);
        const currentDate = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

        // Populate values into PDF template
        document.getElementById('lblRegNo').innerText = regNo;
        document.getElementById('lblFormNo').innerText = formNo;
        document.getElementById('lblDate').innerText = currentDate;
        
        document.getElementById('lblClass').innerText = document.getElementById('applyClass').value;
        document.getElementById('lblStudentName').innerText = document.getElementById('firstName').value + " " + document.getElementById('lastName').value;
        document.getElementById('lblDob').innerText = document.getElementById('dob').value;
        document.getElementById('lblGender').innerText = document.getElementById('gender').value;
        document.getElementById('lblFatherName').innerText = document.getElementById('fatherName').value;
        document.getElementById('lblMotherName').innerText = document.getElementById('motherName').value;
        document.getElementById('lblContact').innerText = document.getElementById('contactNumber').value;
        
        const fullAddr = document.getElementById('address').value + ", " + document.getElementById('city').value + " - " + document.getElementById('pincode').value;
        document.getElementById('lblAddressText').innerText = fullAddr;

        if (uploadedImageBase64) {
            document.getElementById('lblPhotoPreview').src = uploadedImageBase64;
        }
        document.getElementById('pdfLogoPreview').src = schoolLogoBase64;

        // Show template for PDF rendering
        const pdfElement = document.getElementById('pdf-template');
        pdfElement.style.display = 'block';

        const opt = {
            margin:       10,
            filename:     'Admission_Form_' + regNo + '.pdf',
            image:        { type: 'jpeg', quality: 0.98 },
            html2canvas:  { scale: 2, useCORS: true },
            jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };

        // Generate and download PDF, then hide template again
        html2pdf().from(pdfElement).set(opt).save().then(() => {
            pdfElement.style.display = 'none';
            alert('Form submitted successfully! Your PDF receipt has been downloaded.');
            document.getElementById('admissionForm').reset();
        });
    }
</script>

</body>
